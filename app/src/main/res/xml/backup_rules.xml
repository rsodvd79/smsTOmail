<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Escludi il database Room: contiene la password SMTP cifrata con una chiave
         Android Keystore che NON viene ripristinata dal backup. Dopo un restore la
         password sarebbe indecifrabile e l'invio email fallirebbe silenziosamente. -->
    <exclude domain="database" path="filters_db" />
    <exclude domain="database" path="filters_db-wal" />
    <exclude domain="database" path="filters_db-shm" />
</full-backup-content>