<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <!-- Escludi il database Room dal backup cloud e dal trasferimento dispositivo:
         la password SMTP è cifrata con una chiave Android Keystore non trasferibile,
         quindi i dati ripristinati sarebbero indecifrabili. -->
    <cloud-backup>
        <exclude domain="database" path="filters_db" />
        <exclude domain="database" path="filters_db-wal" />
        <exclude domain="database" path="filters_db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="filters_db" />
        <exclude domain="database" path="filters_db-wal" />
        <exclude domain="database" path="filters_db-shm" />
    </device-transfer>
</data-extraction-rules>